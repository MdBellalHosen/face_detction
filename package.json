{
  "name": "moodcam",
  "private": true,
  "version": "1.0.0",
  "description": "MoodCam - real-time Happy/Sad face expression detection in the browser (PWA + Capacitor ready)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "postinstall": "node scripts/download-models.mjs",
    "models": "node scripts/download-models.mjs --force",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@vladmandic/face-api": "^1.7.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
